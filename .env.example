# Copy to .env (gitignored) and fill with a FRESH token each day.
# Dhan access tokens are valid ~1 day; generate a new one from the DhanHQ
# web console (Profile -> Generate Access Token) each session.
# NEVER paste a token into chat, code, or a committed file.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Optional: Upstox live-quote token for the paper track (data-only broker).
UPSTOX_ACCESS_TOKEN=
