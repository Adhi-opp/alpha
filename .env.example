# Copy to .env (gitignored). NEVER paste a token into chat, code, or a
# committed file.

# Dhan access tokens are valid ~1 day; generate a new one from the DhanHQ
# web console (Profile -> Generate Access Token) when needed.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# Upstox — Alpha's PRIMARY token: the read-only Analytics Token (~1-year
# validity; market data REST + v3 websocket streaming). Generate once from
# the Upstox developer console and forget about it.
UPSTOX_ANALYTICS_TOKEN=

# Upstox daily OAuth access_token — OPTIONAL fallback only (expires ~03:30
# IST next day). Minted by scripts/upstox_login.py, which needs the three
# app credentials below. Not required when the analytics token is set.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
